# Salin ke .env lalu isi. JANGAN commit file .env asli.
PORT=8787
NODE_ENV=production
# Lokasi file database SQLite (WAL). Cadangkan file ini + -wal secara berkala.
DB_PATH=./data/rekammedis.db
# Rahasia penandatangan JWT — string acak panjang (>= 32 char). Ganti di produksi!
JWT_SECRET=ganti-dengan-string-acak-yang-sangat-panjang
# Kunci enkripsi brankas kredensial integrasi (AES-256-GCM): 32 byte hex (64 char).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEY=ganti-dengan-64-karakter-hex
# Akun platform (superadmin) awal — dibuat saat server pertama kali jalan bila belum ada.
PLATFORM_ADMIN_EMAIL=owner@rekammedis.web.id
PLATFORM_ADMIN_PASSWORD=ganti-sandi-platform-yang-kuat
# URL publik aplikasi (untuk tautan reset sandi di email)
APP_PUBLIC_URL=https://www.rekammedis.web.id/app/
# Pengiriman email: isi MAIL_WEBHOOK_URL (POST JSON {to,subject,html}) ATAU biarkan
# kosong — email masuk ke outbox DB dan bisa dibaca dari panel platform (mode dev).
MAIL_WEBHOOK_URL=
